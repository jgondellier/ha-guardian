# ============================================================
#  HA Guardian — configuration
#  Copier ce fichier en « .env » puis le compléter.
# ============================================================

# Mot de passe de l'interface web (obligatoire). Au moins 12 caractères variés,
# surtout si l'interface est accessible depuis Internet (openssl rand -base64 18)
APP_PASSWORD=change-moi
# Port de l'interface sur le NAS (réseau de l'hôte)
PORT=8099
# Adresse d'écoute : 0.0.0.0 (tout le réseau local) ou 127.0.0.1 (seulement à
# travers le proxy inversé de DSM)
LISTEN_HOST=0.0.0.0
# Proxys inversés dont on accepte les en-têtes X-Forwarded-For / X-Forwarded-Proto
# (adresse réelle des visiteurs, pour le blocage d'IP). Le proxy de DSM vient de
# 127.0.0.1. Ne jamais mettre « * ».
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Adresse de l'interface vue depuis ton téléphone (VPN ou https://haguardian.exemple.fr).
# Optionnel : active les boutons d'action dans les notifications ntfy.
PUBLIC_URL=

# ---------- Home Assistant ----------
HA_URL=http://192.168.1.10:8123
# Profil HA > Sécurité > Jetons d'accès longue durée
HA_TOKEN=
# Si HA_URL est en https : vérifier son certificat (true seulement si le certificat
# correspond bien à l'adresse de HA_URL, sinon HA paraîtrait injoignable)
HA_VERIFY_TLS=false
# Adresse MAC du mini-PC pour le Wake-on-LAN (optionnel), ex. AA:BB:CC:DD:EE:FF
HA_MAC=
WOL_BROADCAST=255.255.255.255

# ---------- SSH vers le mini-PC (add-on « Advanced SSH & Web Terminal ») ----------
SSH_ENABLED=true
SSH_PORT=22
SSH_USER=hassio

# ---------- SLZB-06 (optionnel) ----------
SLZB_URL=

# ---------- Prise connectée du mini-PC (optionnel) ----------
# none | shelly_gen1 | shelly_gen2 | tasmota
PLUG_TYPE=none
PLUG_URL=http://192.168.1.40
PLUG_USER=
PLUG_PASSWORD=
PLUG_CHANNEL=0
PLUG_OFF_SECONDS=15

# ---------- Routeur Asus principal (optionnel) ----------
# Lit l'état des nœuds AiMesh, la charge et le nombre d'appareils connectés.
# Les équipements à surveiller par ping (routeur principal, nœud secondaire…) se
# déclarent dans l'interface : Réglages > Réseau.
# Attention : le routeur n'accepte qu'une session d'administration à la fois ;
# la lecture (toutes les 5 min, quelques secondes) peut déconnecter l'interface web ouverte.
ASUS_URL=http://192.168.1.1
ASUS_USER=
ASUS_PASSWORD=
# Si ASUS_URL est en https avec le certificat auto-signé du routeur : false
ASUS_VERIFY_TLS=true

# ---------- Notifications (optionnelles) ----------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Signal de vie : URL de ping healthchecks.io (alerte si le NAS s'arrête)
HEARTBEAT_URL=

# ---------- Sauvegardes ----------
# Dossier du NAS où copier les sauvegardes HA (créé s'il n'existe pas)
BACKUP_PATH=/volume1/backup/home-assistant

# ---------- Surveillance ----------
CHECK_INTERVAL=60
SYSTEM_INTERVAL=300
HISTORY_DAYS=14

# ---------- Mise à jour de HA Guardian ----------
# Jeton partagé avec Watchtower : mettre une longue valeur aléatoire
# (sur le NAS : openssl rand -hex 24)
UPDATE_TOKEN=
GITHUB_REPO=jgondellier/ha-guardian
# Seulement si le dépôt GitHub est privé (jeton en lecture seule)
GITHUB_TOKEN=
